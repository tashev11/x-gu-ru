    <script>
        const SERVICE_CARDS = {{ service_cards_json | safe }};
        const CLUSTER_LABELS = { seo: 'SEO-продвижение', webdev: 'Создание сайтов', ads: 'Реклама', audit: 'Аудит' };
        const CLUSTER_ORDER = ['seo', 'webdev', 'ads', 'audit'];
        const servicesGroups = document.getElementById('servicesGroups');

        (function renderServiceGroups() {
            const groups = {};
            for (const card of SERVICE_CARDS) {
                const c = CLUSTER_LABELS[card.cluster] ? card.cluster : 'seo';
                (groups[c] = groups[c] || []).push(card);
            }
            for (const key of CLUSTER_ORDER) {
                const items = groups[key];
                if (!items || !items.length) continue;
                const section = document.createElement('div');
                section.className = 'reveal active';
                const head = document.createElement('div');
                head.className = 'flex items-center gap-3 mb-4';
                head.innerHTML = `<h3 class=\"text-lg font-bold text-white\">${CLUSTER_LABELS[key]}</h3>`
                    + `<span class=\"text-xs font-medium text-gray-500 px-2 py-0.5 rounded-full border border-white/10\">${items.length}</span>`
                    + `<div class=\"h-px bg-gray-800 flex-1\"></div>`;
                section.appendChild(head);
                const wrap = document.createElement('div');
                wrap.className = 'flex flex-wrap gap-2';
                for (const card of items) {
                    const a = document.createElement('a');
                    a.href = card.href;
                    a.className = 'text-sm text-gray-300 px-3 py-2 rounded-lg border border-white/10 hover:border-indigo-400/60 hover:text-white hover:bg-indigo-500/10 transition';
                    a.textContent = card.title;
                    wrap.appendChild(a);
                }
                section.appendChild(wrap);
                servicesGroups.appendChild(section);
            }
        })();

        function reveal() {
            const reveals = document.querySelectorAll('.reveal');
            for (let i = 0; i < reveals.length; i++) {
                const windowHeight = window.innerHeight;
                const elementTop = reveals[i].getBoundingClientRect().top;
                if (elementTop < windowHeight - 100) reveals[i].classList.add('active');
            }
        }
        window.addEventListener('scroll', reveal);
        reveal();

        window.addEventListener('scroll', () => {
            const nav = document.getElementById('navbar');
            if (window.scrollY > 50) {
                nav.classList.add('bg-slate-900/90');
            } else {
                nav.classList.remove('bg-slate-900/90');
            }
        });

        function toggleFaq(button) {
            const item = button.parentElement;
            const isActive = item.classList.contains('active');
            document.querySelectorAll('.faq-item').forEach(el => el.classList.remove('active'));
            if (!isActive) item.classList.add('active');
        }

        document.getElementById('contactForm').addEventListener('submit', async function(e) {
            e.preventDefault();
            const btn = this.querySelector('button');
            const originalText = btn.textContent;
            btn.textContent = 'Отправка...';
            btn.disabled = true;

            const payload = {
                name: document.getElementById('leadName').value.trim(),
                phone: document.getElementById('leadPhone').value.trim(),
                website: document.getElementById('leadWebsite').value.trim() || null,
                service: 'SEO аудит',
                city: '{{ city_name }}',
                page_url: window.location.href,
                referrer: document.referrer || null,
            };

            try {
                const resp = await fetch('/api/v1/leads/submit', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });
                const data = await resp.json();
                if (!resp.ok || !data.ok) {
                    throw new Error(data.detail || 'submit failed');
                }
                btn.textContent = 'Отправлено';
                setTimeout(() => {
                    btn.textContent = originalText;
                    btn.disabled = false;
                    this.reset();
                }, 1200);
            } catch (err) {
                btn.textContent = originalText;
                btn.disabled = false;
                console.error(err);
                alert('Не удалось отправить заявку');
            }
        });
    </script>
