    <script>
        const cities = [
            "Abakan", "Achinsk", "Almetevsk", "Angarsk", "Arkhangelsk", "Armavir", "Artem", "Arzamas", "Astrakhan",
            "Balakovo", "Balashikha", "Barnaul", "Bataisk", "Belgorod", "Berdsk", "Berezniki", "Biisk", "Blagoveshchensk",
            "Bratsk", "Briansk", "Cheboksary", "Cheliabinsk", "Cherepovets", "Cherkessk", "Chita", "Derbent",
            "Dimitrovgrad", "Dolgoprudnyi", "Domodedovo", "Dzerzhinsk", "Ekaterinburg", "Elektrostal", "Elista",
            "Engels", "Essentuki", "Evpatoriia", "Groznyi", "Iakutsk", "Iaroslavl", "Ioshkar-Ola", "Irkutsk",
            "Iuzhno-Sakhalinsk", "Ivanovo", "Izhevsk", "Kaliningrad", "Kaluga", "Kamensk-Uralskii", "Kamyshin",
            "Kaspiisk", "Kazan", "Kemerovo", "Kerch", "Khabarovsk", "Khanty-Mansiisk", "Khasaviurt", "Khimki",
            "Kirov", "Kislovodsk", "Kolomna", "Kolpino", "Komsomolsk-Na-Amure", "Kopeisk", "Korolev", "Kostroma",
            "Kovrov", "Krasnodar", "Krasnogorsk", "Krasnoiarsk", "Kurgan", "Kursk", "Kyzyl", "Lipetsk", "Liubertsy",
            "Magnitogorsk", "Maikop", "Makhachkala", "Miass", "Mikhailovsk", "Moskva", "Murmansk", "Murom",
            "Mytishchi", "Naberezhnye-Chelny", "Nakhodka", "Nalchik", "Nazran", "Nefteiugansk", "Neftekamsk",
            "Nevinnomyssk", "Nizhnekamsk", "Nizhnevartovsk", "Nizhnii-Novgorod", "Nizhnii-Tagil", "Noginsk",
            "Noiabrsk", "Norilsk", "Novocheboksarsk", "Novocherkassk", "Novokuznetsk", "Novomoskovsk",
            "Novorossiisk", "Novoshakhtinsk", "Novosibirsk", "Novyi-Urengoi", "Obninsk", "Odintsovo", "Oktiabrskii",
            "Omsk", "Orekhovo-Zuevo", "Orel", "Orenburg", "Orsk", "Penza", "Perm", "Pervouralsk",
            "Petropavlovsk-Kamchatskii", "Petrozavodsk", "Piatigorsk", "Podolsk", "Prokopevsk", "Pskov", "Pushkin",
            "Pushkino", "Ramenskoe", "Reutov", "Riazan", "Rostov-Na-Donu", "Rubtsovsk", "Rybinsk", "Salavat",
            "Samara", "Sankt-Peterburg", "Saransk", "Saratov", "Sergiev-Posad", "Serpukhov", "Sevastopol",
            "Severodvinsk", "Seversk", "Shakhty", "Shchelkovo", "Simferopol", "Smolensk", "Sochi", "Staryi-Oskol",
            "Stavropol", "Sterlitamak", "Surgut", "Syktyvkar", "Syzran", "Taganrog", "Tambov", "Tiumen", "Tobolsk",
            "Toliatti", "Tomsk", "Tula", "Tver", "Ufa", "Ulan-Ude", "Ulianovsk", "Ussuriisk", "Velikii-Novgorod",
            "Vidnoe", "Vladikavkaz", "Vladimir", "Vladivostok", "Volgodonsk", "Volgograd", "Vologda", "Volzhskii",
            "Voronezh", "Zelenograd", "Zhukovskii", "Zlatoust"
        ];

        const cityGrid = document.getElementById('cityGrid');
        const citySearch = document.getElementById('citySearch');

        function renderCities(filter = "") {
            cityGrid.innerHTML = "";
            const filtered = cities.filter(city => city.toLowerCase().includes(filter.toLowerCase()));
            filtered.forEach(city => {
                const a = document.createElement('a');
                a.href = `/${city.toLowerCase()}/`;
                a.className = 'city-tag block text-center py-2 px-3 rounded-lg hover:bg-white/5';
                a.textContent = city;
                cityGrid.appendChild(a);
            });
        }

        renderCities();
        citySearch.addEventListener('input', (e) => renderCities(e.target.value));

        function reveal() {
            const reveals = document.querySelectorAll('.reveal');
            for (let i = 0; i < reveals.length; i++) {
                const windowHeight = window.innerHeight;
                const elementTop = reveals[i].getBoundingClientRect().top;
                if (elementTop < windowHeight - 100) {
                    reveals[i].classList.add('active');
                }
            }
        }

        window.addEventListener('scroll', reveal);
        reveal();

        window.addEventListener('scroll', () => {
            const nav = document.getElementById('navbar');
            if (window.scrollY > 50) {
                nav.classList.add('bg-slate-900/90');
            } else {
                nav.classList.remove('bg-slate-900/90');
            }
        });

        document.getElementById('contactForm').addEventListener('submit', async function(e) {
            e.preventDefault();
            const btn = this.querySelector('button');
            const originalText = btn.textContent;
            btn.textContent = 'Отправка...';
            btn.disabled = true;

            const payload = {
                name: document.getElementById('leadName').value.trim(),
                phone: document.getElementById('leadPhone').value.trim(),
                website: document.getElementById('leadWebsite').value.trim() || null,
                service: 'SEO аудит',
                city: document.getElementById('leadCity').value,
                utm_source: new URLSearchParams(window.location.search).get('utm_source'),
                utm_medium: new URLSearchParams(window.location.search).get('utm_medium'),
                utm_campaign: new URLSearchParams(window.location.search).get('utm_campaign'),
                utm_term: new URLSearchParams(window.location.search).get('utm_term'),
                utm_content: new URLSearchParams(window.location.search).get('utm_content'),
                page_url: window.location.href,
                referrer: document.referrer || null,
            };

            try {
                const resp = await fetch('/api/v1/leads/submit', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });
                const data = await resp.json();
                if (!resp.ok || !data.ok) {
                    throw new Error(data.detail || 'submit failed');
                }

                btn.textContent = 'Отправлено!';
                btn.classList.add('bg-green-600');
                setTimeout(() => {
                    btn.textContent = originalText;
                    btn.classList.remove('bg-green-600');
                    btn.disabled = false;
                    this.reset();
                    alert('Спасибо! Мы свяжемся с вами в течение 15 минут.');
                }, 1200);
            } catch (err) {
                btn.textContent = originalText;
                btn.disabled = false;
                alert('Ошибка отправки заявки. Попробуйте ещё раз.');
                console.error(err);
            }
        });
    </script>
</body>
