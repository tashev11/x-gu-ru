# Защита SSH от перебора паролей.
# Файл jail.local переопределяет настройки по умолчанию и не затирается
# при обновлении пакета.

[DEFAULT]
# Свой IP и локальные адреса не банятся никогда — страховка от самоблокировки.
ignoreip = 127.0.0.1/8 ::1 YOUR_ADMIN_IP

# Бан на час. Для перебора паролей этого достаточно: боты уходят к другим целям.
bantime = 1h
# Окно, в котором считаются неудачные попытки.
findtime = 10m
# Столько неудач подряд — и бан.
maxretry = 5

# Читаем systemd-журнал, а не файл: auth.log на этом сервере периодически
# обнуляется автоочисткой, а журнал переживает ротацию.
backend = systemd

[sshd]
enabled = true
port = ssh
# Агрессивный режим ловит и перебор паролей, и сканирование ботами.
mode = aggressive
