# Защита SSH от перебора паролей.
# Файл jail.local переопределяет настройки по умолчанию и не затирается
# при обновлении пакета.

[DEFAULT]
# Локальные адреса не банятся. Если нужен постоянный allowlist для внешнего
# административного IP, добавьте реальный IP/CIDR в серверный конфиг, но не
# коммитьте персональный адрес как шаблонное значение.
ignoreip = 127.0.0.1/8 ::1

# Бан на час.
bantime = 1h
# Окно, в котором считаются неудачные попытки.
findtime = 10m
# Столько неудач подряд — и бан.
maxretry = 5

# Читаем systemd-журнал: он корректно переживает стандартную ротацию логов.
backend = systemd

[sshd]
enabled = true
port = ssh
# Агрессивный режим ловит и перебор паролей, и сканирование ботами.
mode = aggressive
