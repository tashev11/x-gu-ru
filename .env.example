# Public example only. Never commit real credentials.

# Core application
BASE_DOMAIN=x-gu.ru
DATABASE_URL=postgresql+psycopg://user:password@127.0.0.1:5432/xgu

# Build/deploy paths used by the private backend integration
RELEASES_ROOT=/var/www/x-gu.ru/releases
HUGO_SOURCE_DIR=/opt/p3-app/hugo

# Analytics
YANDEX_METRIKA_ID=
YANDEX_METRIKA_GOAL_SUBMIT=lead_submit
GOOGLE_SEARCH_CONSOLE_SITE_URL=https://x-gu.ru/

# Optional notifications / external integrations
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Reviewed source policy. Do not point this at index_policy.example.json.
# shrink_index.py turns this reviewed source into <release>/.xgu-index-keep.json.
XGU_INDEX_POLICY=/opt/p3-app/data/index_policy.json

# Runtime release policy. In normal production these are usually left unset:
# the generator resolves /var/www/x-gu.ru/current/.xgu-index-keep.json itself.
XGU_CURRENT_ROOT=/var/www/x-gu.ru/current
XGU_WHITELIST=/opt/p3-app/data/whitelist.txt
# XGU_KEEP_CONFIG=/var/www/x-gu.ru/releases/20260910-120000/.xgu-index-keep.json

# SEO healthcheck. When SEOHC_KEEP_CONFIG is unset, the healthcheck first uses
# <SEOHC_ROOT>/.xgu-index-keep.json. Predeploy always requires that release file.
SEOHC_ROOT=/var/www/x-gu.ru/current
SEOHC_BASE_URL=https://x-gu.ru
SEOHC_WHITELIST=/opt/p3-app/data/whitelist.txt
# SEOHC_KEEP_CONFIG=/var/www/x-gu.ru/current/.xgu-index-keep.json
SEOHC_NOTIFY_ENABLED=false
SEOHC_NOTIFY_ON_OK=false

# Serious release-integrity checks default to zero tolerated failures.
SEOHC_MAX_UNEXPECTED_NOINDEX_OPEN=0
SEOHC_MAX_UNEXPECTED_INDEX_CLOSED=0
SEOHC_MAX_OPEN_MISSING_SITEMAP=0
SEOHC_MAX_CLOSED_IN_SITEMAP=0
SEOHC_MAX_BAD_SITEMAP_URLS=0
SEOHC_MAX_SITEMAP_ORPHAN_URLS=0
SEOHC_MAX_CANONICAL_MISMATCH=0
SEOHC_MAX_CANONICAL_DUP_PAGES=0
SEOHC_MAX_INVALID_JSONLD_PAGES=0
SEOHC_MAX_BROKEN_INTERNAL_LINKS=0

# Migration/emergency escape hatches. Keep unset/false in normal production.
# XGU_ALLOW_MISSING_KEEP_CONFIG=0
# XGU_ALLOW_LEGACY_KEEP_CONFIG=0
# XGU_TEMPLATE_DIR=/opt/p3-app/server-opt/templates

# The private app.* backend may require additional variables that are not
# part of this public repository. Keep real secrets in the server secret store.
